#
# ImmortalWrt 25.12.2 — Xiaomi Mi Router 3G (R3G) — mesh 子设备版
# 源码: immortalwrt/immortalwrt @ tag v25.12.2 (4fc16f2)   内核 6.12   apk
#
# 定位：mesh 子设备 —— 不做主路由 / 不做代理 / 不做 NAT / 不做 QoS
# 原则：无法用户安装的（内核模块 / 编译期开关）必须内置；
#       用户态包能 apk 装的一律不内置。
# 不内置（官方源都有，刷完 apk add 补）：
#   luci-app-easymesh        你仓库里自己编
#   dawn + luci-app-dawn     mesh 漫游辅助
#   luci-proto-batman-adv    LuCI 里的 batman-adv 协议界面
#

# ============ 1. 目标平台与设备 ============
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# ============ 2. LuCI 基础与外观 ============
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ============ 3. EasyMesh / B.A.T.M.A.N. —— 只内置「装不上」的部分 ============
# 内核模块 + 编译期开关：自编内核 CRC/vermagic 与官方 kmods 源不匹配，事后装不上
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_BATMAN_ADV_BLA=y
CONFIG_BATMAN_ADV_DAT=y
CONFIG_BATMAN_ADV_MCAST=y
CONFIG_PACKAGE_MAC80211_MESH=y
# batctl 是 kmod-batman-adv 的硬依赖（DEPENDS 里写死 +batctl），删不掉
CONFIG_PACKAGE_batctl-default=y

# ============ 4. 管理 / 监控（mesh 节点日常要用的几个） ============
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# ============ 5. USB / 文件系统（内核模块，装不上，必须内置） ============
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y

# ============ 6. NLS 编码：只留中文/通用，日韩去掉 ============
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp936=y
# CONFIG_PACKAGE_kmod-nls-cp932 is not set
# CONFIG_PACKAGE_kmod-nls-cp950 is not set

# ============ 7. 关掉被默认塞进来的（省空间） ============
# diskman 默认 y，会带 btrfs-progs + kmod-fs-btrfs + kmod-lib-raid6 + kmod-lib-xor
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs is not set
# dnstap 是 DNS 日志转发，没人依赖它却默认 y，会带 libfstrm + libprotobuf-c
# CONFIG_PACKAGE_knot-resolver_dnstap is not set
# rclone 本体并未选中，这两个 INCLUDE 是残留符号
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set
